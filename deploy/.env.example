# Copiar a /opt/dazgreen/.env.production, fuera de releases; chmod 600.
# Completar secretos distintos. No usar el .env del desarrollo local.
MYSQL_DATABASE=das_green
MYSQL_USER=das_green_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
MAX_VIDEO_BYTES=157286400
PROXY_NETWORK=dazgreen_edge
MYSQL_VOLUME_NAME=dazgreen_mysql_data
MEDIA_VOLUME_NAME=dazgreen_media_data
# Para un build manual; CI usa imágenes de Registry con el SHA del commit.
WEB_IMAGE=dazgreen-web:local
API_IMAGE=dazgreen-api:local
